{
  "rewrites": [
    { "source": "/auth/login", "destination": "/api/gateway?op=login" },
    { "source": "/lists/:listName/recommendations", "destination": "/api/gateway?op=recommendations&listName=:listName" },
    { "source": "/lists/:listName", "destination": "/api/gateway?op=list&listName=:listName" },
    { "source": "/lists", "destination": "/api/gateway?op=lists" },
    { "source": "/spotify/genres", "destination": "/api/gateway?op=genres" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
